# Future Classroom — environment configuration
# Copy to .env.local and adjust. Never commit real keys.

# --- AI (optional) ---------------------------------------------------------
# Without a key the platform runs in "offline mode": built-in lesson templates,
# teacher-written hints and keyword search still work, and every screen says
# clearly that AI is not connected.
ANTHROPIC_API_KEY=
# Model used for lesson/quiz generation, hints and tutoring.
AI_MODEL=claude-opus-5

# --- Data ------------------------------------------------------------------
# SQLite database file (created automatically on first start).
DATABASE_PATH=./data/future-classroom.db
# Folder for uploaded teaching materials (kept outside /public).
UPLOAD_DIR=./data/uploads
# Seed demo teachers, students, lessons and materials into an empty database.
# Every demo account (including an administrator) uses the password
# "demo1234". Default: on with `npm run dev`, off with `npm start`.
SEED_DEMO=true

# --- Demo ------------------------------------------------------------------
# Shows one-click demo sign-in buttons. Default: on with `npm run dev`, off
# with `npm start`. Never enable it for real school use; create accounts with
# `npm run user:create` and add students from a class page.
DEMO_MODE=true

# --- Security --------------------------------------------------------------
# Force the Secure flag on cookies (recommended whenever the site is served
# over HTTPS). When unset, it is enabled automatically for HTTPS requests.
# COOKIE_SECURE=true

# --- Language -------------------------------------------------------------
# Interface language for everyone who has not chosen one themselves (ka or en).
# When unset, the browser's preferred language decides, and Georgian is used
# for any other browser language. The demo school is seeded in this language
# (Georgian unless it is set to en).
# DEFAULT_LANGUAGE=ka

# --- Library QR labels -----------------------------------------------------
# Address printed in QR codes on library labels, as workstations and phones
# reach the server (for example http://192.168.1.10:3000). When unset, the
# address of the current request is used.
# PUBLIC_BASE_URL=

# --- Programming Lab: C++ checking (optional) ------------------------------
# Python always runs in the student's browser. To check C++ on a server, run
# your own Judge0 instance (https://judge0.com) and point to it here. Without
# it, students compile C++ locally and paste their outputs (self-checked).
# JUDGE0_URL=http://judge0.school.local:2358
# JUDGE0_TOKEN=
# JUDGE0_PYTHON_ID=71
# JUDGE0_CPP_ID=54
